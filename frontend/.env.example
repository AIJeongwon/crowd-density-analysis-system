# Kakao Developers에서 발급한 JavaScript 키를 사용합니다.
NEXT_PUBLIC_KAKAO_MAP_APP_KEY=

# 비워 두면 같은 Workers의 /api를 사용합니다.
# 기존 Python 서버 사용 시에만 http://127.0.0.1:8000으로 설정합니다.
NEXT_PUBLIC_API_BASE_URL=
NEXT_PUBLIC_STATUS_POLL_INTERVAL_MS=5000
NEXT_PUBLIC_API_TIMEOUT_MS=10000
NEXT_PUBLIC_STATUS_WINDOW_SECONDS=30

# 백엔드 연결 전 UI 확인용입니다. 운영에서는 false를 권장합니다.
NEXT_PUBLIC_ENABLE_DEMO_FALLBACK=false

# Open Graph 이미지의 절대 URL 기준입니다.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
